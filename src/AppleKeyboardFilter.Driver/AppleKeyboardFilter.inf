; Apple Magic Keyboard HID lower-filter driver for Apple Peripherals for Windows.

[Version]
Signature="$WINDOWS NT$"
; The filter attaches to the keyboard *collection* (Col01), below kbdhid, where
; the 10-byte input report still carries the vendor fn/lock bits. Attaching to
; the Bluetooth transport instead does not work on Windows 11: the interrupt
; channel data never passes through a lower filter there.
Class=Keyboard
ClassGuid={4d36e96b-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
CatalogFile=AppleKeyboardFilter.cat
DriverPackageDisplayName=%DriverPackageDisplayName%
DriverPackageType=PlugAndPlay
DriverVer=09/19/2026,0.6.0.0
PnpLockdown=1

[ControlFlags]
ExcludeFromSelect=*

[DestinationDirs]
DefaultDestDir=12
DriverCopyFiles=12

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
AppleKeyboardFilter.sys=1

[Manufacturer]
%Manufacturer%=AppleKeyboardFilter,NTamd64,NTarm64

[AppleKeyboardFilter.NTamd64]
%MagicKeyboard.Touch.Bluetooth.DevDesc%=Collection_Install,HID\{00001124-0000-1000-8000-00805f9b34fb}_VID&0001004c_PID&029c&Col01
%MagicKeyboard.Bluetooth.DevDesc%=Collection_Install,HID\{00001124-0000-1000-8000-00805f9b34fb}_VID&0001004c_PID&0320&Col01
%MagicKeyboard.Legacy.Bluetooth.DevDesc%=Collection_Install,HID\{00001124-0000-1000-8000-00805f9b34fb}_VID&0001004c_PID&0267&Col01
%MagicKeyboard.Numeric.Bluetooth.DevDesc%=Collection_Install,HID\{00001124-0000-1000-8000-00805f9b34fb}_VID&0001004c_PID&026c&Col01
%MagicKeyboard.UsbC.DevDesc%=Collection_Install,HID\VID_05AC&PID_0321&MI_01&Col01
%MagicKeyboard.Legacy.Usb.DevDesc%=Collection_Install,HID\VID_05AC&PID_0267&MI_01&Col01
%MagicKeyboard.Numeric.Usb.DevDesc%=Collection_Install,HID\VID_05AC&PID_026C&MI_01&Col01

[AppleKeyboardFilter.NTarm64]
%MagicKeyboard.Touch.Bluetooth.DevDesc%=Collection_Install,HID\{00001124-0000-1000-8000-00805f9b34fb}_VID&0001004c_PID&029c&Col01
%MagicKeyboard.Bluetooth.DevDesc%=Collection_Install,HID\{00001124-0000-1000-8000-00805f9b34fb}_VID&0001004c_PID&0320&Col01
%MagicKeyboard.Legacy.Bluetooth.DevDesc%=Collection_Install,HID\{00001124-0000-1000-8000-00805f9b34fb}_VID&0001004c_PID&0267&Col01
%MagicKeyboard.Numeric.Bluetooth.DevDesc%=Collection_Install,HID\{00001124-0000-1000-8000-00805f9b34fb}_VID&0001004c_PID&026c&Col01
%MagicKeyboard.UsbC.DevDesc%=Collection_Install,HID\VID_05AC&PID_0321&MI_01&Col01
%MagicKeyboard.Legacy.Usb.DevDesc%=Collection_Install,HID\VID_05AC&PID_0267&MI_01&Col01
%MagicKeyboard.Numeric.Usb.DevDesc%=Collection_Install,HID\VID_05AC&PID_026C&MI_01&Col01

; kbdhid stays the function driver; this package only inserts the filter
; beneath it, so the collection keeps behaving as an ordinary HID keyboard.
[Collection_Install.NT]
Include=keyboard.inf
Needs=HID_Keyboard_Inst.NT
CopyFiles=DriverCopyFiles

[Collection_Install.NT.HW]
Include=keyboard.inf
Needs=HID_Keyboard_Inst.NT.HW
AddReg=LowerFilter_AddReg

[Collection_Install.NT.Services]
Include=keyboard.inf
Needs=HID_Keyboard_Inst.NT.Services
AddService=AppleKeyboardFilter,,AppleKeyboardFilter_ServiceInstall

[DriverCopyFiles]
AppleKeyboardFilter.sys

[LowerFilter_AddReg]
HKR,,"LowerFilters",0x00010008,"AppleKeyboardFilter"

[AppleKeyboardFilter_ServiceInstall]
DisplayName=%ServiceDescription%
ServiceType=%SERVICE_KERNEL_DRIVER%
StartType=%SERVICE_DEMAND_START%
ErrorControl=%SERVICE_ERROR_NORMAL%
ServiceBinary=%12%\AppleKeyboardFilter.sys
AddReg=AppleKeyboardFilter_ServiceSettings

[AppleKeyboardFilter_ServiceSettings]
HKR,"Parameters",EmitFnAsF23,0x00010001,1
HKR,"Parameters",Diagnostics,0x00010001,0
HKR,"Parameters",FnModifier,0x00010001,1
HKR,"Parameters",FnUsage,0x00010001,0
HKR,"Parameters",LockModifier,0x00010001,0
HKR,"Parameters",LockUsage,0x00010001,0x4C
HKR,"Parameters",SwapIsoKeys,0x00010001,1

[Strings]
Provider="Apple Peripherals for Windows"
Manufacturer="Apple Peripherals for Windows"
DriverPackageDisplayName="Apple Keyboard Filter"
DiskName="Apple Keyboard Filter Install Disk"
ServiceDescription="Apple Keyboard Filter"
MagicKeyboard.Touch.Bluetooth.DevDesc="Apple Magic Keyboard Touch ID Bluetooth Globe/Fn Filter"
MagicKeyboard.Bluetooth.DevDesc="Apple Magic Keyboard Bluetooth Globe/Fn Filter"
MagicKeyboard.UsbC.DevDesc="Apple Magic Keyboard USB-C Globe/Fn Filter"
MagicKeyboard.Legacy.Bluetooth.DevDesc="Apple Magic Keyboard Bluetooth Globe/Fn Filter"
MagicKeyboard.Legacy.Usb.DevDesc="Apple Magic Keyboard USB Globe/Fn Filter"
MagicKeyboard.Numeric.Bluetooth.DevDesc="Apple Magic Keyboard Numeric Bluetooth Globe/Fn Filter"
MagicKeyboard.Numeric.Usb.DevDesc="Apple Magic Keyboard Numeric USB Globe/Fn Filter"
SERVICE_KERNEL_DRIVER=1
SERVICE_DEMAND_START=3
SERVICE_ERROR_NORMAL=1
